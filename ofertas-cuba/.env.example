# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# El Toque (tasas USD/EUR) — reutilizar secret org PalmApps
EL_TOQUE_API_KEY=

# Bot OfertasCuba (NUEVO en BotFather; NO es PalmAppsNotify)
TELEGRAM_OFERTAS_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=

# Telegram Client API — scraper de grupos/canales publicos
# Crear en https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generar con: pnpm --filter @ofertas-cuba/scraper auth:telegram
TELEGRAM_USER_SESSION=

# Facebook scraper (fase 1; cookies opcionales si hace falta)
FB_SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; OfertasCuba/0.1; +https://ofertascuba.vercel.app)

# Web
NEXT_PUBLIC_APP_URL=https://ofertascuba.vercel.app
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Ofertas_Cuba_bot
